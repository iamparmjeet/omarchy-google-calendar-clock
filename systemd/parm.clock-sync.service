# Portable reference unit — scripts/setup.sh rewrites this with the machine's
# detected absolute paths (python3 location + plugin dir) when it installs the
# timer. %h expands to the user's home under `systemctl --user`.
[Unit]
Description=Sync Google Calendar and Tasks for parm.clock (gws)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env python3 %h/.config/omarchy/plugins/parm.clock/sync/sync.py
TimeoutStartSec=600
Nice=10

[Install]
WantedBy=default.target
